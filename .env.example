# Copiez ce fichier en ".env" puis remplissez les mots de passe. Ne commitez jamais ".env".

# --- Ollama (IA locale) ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.2
EMBED_MODEL=bge-m3
NUM_CTX=4096

# --- Base statistique (copie de prod_mhm_ps, accès LECTURE SEULE) ---
SRC_HOST=localhost
SRC_PORT=5432
SRC_DB=database_source
SRC_USER=user_ro
SRC_PASSWORD=
SRC_ALLOWED_SCHEMAS=analytics
SQL_TIMEOUT_MS=10000
MAX_EXPLAIN_COST=200000

# --- Base vectorielle (documents / RAG) ---
VEC_HOST=localhost
VEC_PORT=5432
VEC_DB=datavec_kb
VEC_USER=dbvector_user
VEC_PASSWORD=
MIN_SCORE=0.55
MHM_DEBUG=0

# --- Authentification (jeton émis par Laravel) ---
# En développement local : AUTH_DISABLED=1. En production : AUTH_DISABLED=0 + secret partagé avec Laravel.
AUTH_DISABLED=1
JWT_SECRET=
JWT_ALGORITHM=HS256

# --- Veille sanitaire (page d'accueil Médecin) ---
# Le serveur télécharge les flux (OMS, OMS Afrique, The Lancet, NEJM) puis les met en cache.
FEED_CACHE_TTL_S=1800
FEED_TIMEOUT_S=8
FEED_MAX_ITEMS_PER_SOURCE=15
# Remplacer l'adresse d'un flux sans modifier le code (ids : WHO, AFRO, LANCET, NEJM), ex. :
# FEED_URLS_WHO=https://www.who.int/rss-feeds/news-english.xml

# --- Divers ---
APP_TZ=Indian/Antananarivo
CORS_ORIGINS=http://localhost:5173
AUDIT_LOG=logs/audit_log.jsonl
