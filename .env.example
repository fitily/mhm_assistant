# Copiez ce fichier en ".env" puis remplissez les mots de passe. Ne commitez jamais ".env".

# --- Ollama (IA locale) ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.2
EMBED_MODEL=bge-m3
NUM_CTX=4096

# --- Base statistique (copie de prod_mhm_ps, accès LECTURE SEULE) ---
SRC_HOST=localhost
SRC_PORT=5432
SRC_DB=database_source
SRC_USER=user_ro
SRC_PASSWORD=
SRC_ALLOWED_SCHEMAS=analytics
SQL_TIMEOUT_MS=10000
MAX_EXPLAIN_COST=200000

# --- Base vectorielle (documents / RAG) ---
VEC_HOST=localhost
VEC_PORT=5432
VEC_DB=datavec_kb
VEC_USER=dbvector_user
VEC_PASSWORD=
MIN_SCORE=0.55
MHM_DEBUG=0

# --- Base des utilisateurs (comptes et rôles : base SÉPARÉE des données médicales) ---
APP_HOST=localhost
APP_PORT=5432
APP_DB=ambovo_app
APP_USER=ambovo_app
APP_PASSWORD=

# --- Authentification (jetons émis par FastAPI à la connexion) ---
# En développement local sans connexion : AUTH_DISABLED=1 (le rôle simulé est DEV_ROLE : doctor ou admin).
# Pour tester la vraie connexion et en production : AUTH_DISABLED=0.
# JWT_SECRET : 32 caractères minimum. Pour en générer un :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_DISABLED=1
DEV_ROLE=admin
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Superset (dashboards embarqués) ---
# Adresse de Superset vue depuis FastAPI : localhost:18088 si FastAPI tourne sur la machine (make run),
# http://superset-prod:8088 si FastAPI tourne dans Docker sur le même réseau que Superset.
SUPERSET_URL=http://localhost:18088
# Compte technique DÉDIÉ au backend (voir docs/superset-compte-technique.md) : jamais un compte personnel.
SUPERSET_USERNAME=
SUPERSET_PASSWORD=
SUPERSET_TIMEOUT=10
# Catalogue des dashboards autorisés (par défaut config/dashboards.yaml)
# DASHBOARDS_FILE=config/dashboards.yaml

# --- Divers ---
APP_TZ=Indian/Antananarivo
CORS_ORIGINS=http://localhost:5173
AUDIT_LOG=logs/audit_log.jsonl
