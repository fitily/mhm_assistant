# Copier ce fichier en .env puis adapter.
# (fichier caché : dans le terminal, utilisez « ls -a » pour le voir)

# Adresse du backend FastAPI (utilisée par le proxy de développement : npm run dev)
VITE_BACKEND_URL=http://localhost:8000

# Préfixe des routes appelées par le navigateur. Le proxy le retire :
# /api/v1/chat  ->  http://localhost:8000/v1/chat
VITE_API_BASE_URL=/api

# Connexion fictive (démonstration sans backend) : VITE_MOCK_AUTH=true
#   demo@mhm.org / demo1234      -> administrateur (statistiques)
#   medecin@mhm.org / demo1234   -> médecin (documents)
# Vraie connexion avec les comptes créés par scripts/create_user.py : VITE_MOCK_AUTH=false
VITE_MOCK_AUTH=true

# false = vrai backend ; true = fausses réponses du chat (aucun backend nécessaire)
VITE_MOCK_CHAT=false

# Route de connexion FastAPI (valeur par défaut, à ne changer que si nécessaire) :
# VITE_LOGIN_URL=/v1/auth/login

# Aperçu de l'accueil médecin et du fil « Medical news » avec des cartes fictives : true
VITE_NEWS_PREVIEW=false
